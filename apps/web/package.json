{
  "name": "@taven/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Taven public Nuxt application",
  "scripts": {
    "postinstall": "nuxt prepare",
    "build": "nuxt build",
    "dev": "nuxt dev --port 3000",
    "start": "node .output/server/index.mjs",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run --exclude 'e2e/**'",
    "test:e2e": "playwright test",
    "test:e2e:integration": "INTEGRATION_TEST=true playwright test --project=integration",
    "test:lighthouse": "pnpm build && node scripts/lighthouse.mjs",
    "test:watch": "vitest --exclude 'e2e/**'"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@taven/openapi-client": "workspace:*",
    "@taven/ui-web": "workspace:*",
    "fflate": "^0.8.3",
    "nuxt": "^4.2.0",
    "robust-predicates": "^3.0.3",
    "saxes": "^6.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "lighthouse": "13.4.1",
    "tailwindcss": "4.3.3"
  }
}
