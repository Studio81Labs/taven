# Nuxt maps these values to private server and public browser runtime config.
NUXT_API_BASE_URL=http://localhost:3001
NUXT_PUBLIC_API_BASE_URL=http://localhost:3001
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep public acquisition closed until backend legal approvals and launch gates are effective.
NUXT_PUBLIC_AUTOMATIC_QUOTE_ENABLED=false
