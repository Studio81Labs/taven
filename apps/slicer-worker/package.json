{
  "name": "@taven/slicer-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Taven opt-in BullMQ slicer worker",
  "exports": {
    "./fixture-runtime": {
      "types": "./src/fixture-runtime.ts",
      "default": "./src/fixture-runtime.ts"
    }
  },
  "scripts": {
    "contracts:build": "pnpm --filter @taven/slicer-contracts... build",
    "prebuild": "pnpm contracts:build",
    "build": "tsc -p tsconfig.json",
    "predev": "pnpm contracts:build",
    "dev": "tsx src/main.ts",
    "prestart": "pnpm contracts:build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm contracts:build",
    "test": "vitest run",
    "pretest:watch": "pnpm contracts:build",
    "test:watch": "vitest",
    "pretest:integration": "pnpm contracts:build",
    "test:integration": "TAVEN_SLICER_WORKER_INTEGRATION=1 vitest run src/runtime-e2e.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@taven/slicer-contracts": "workspace:*",
    "bullmq": "^5.81.3",
    "dotenv": "^17.4.2",
    "robust-predicates": "^3.0.3",
    "saxes": "^6.0.0"
  }
}
