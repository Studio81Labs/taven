TAVEN_REDIS_URL=redis://127.0.0.1:6381
# For Coolify rediss://, use the private CA bootstrap below. The database names
# are accepted as a shared Coolify CA because PostgreSQL and Redis use the same
# owner-managed CA on a host.
# TAVEN_REDIS_CA_CERT_B64=
# TAVEN_REDIS_CA_CERT_PATH=/etc/secrets/redis-ca.crt
TAVEN_S3_ENDPOINT=http://127.0.0.1:9010
TAVEN_S3_REGION=us-east-1
TAVEN_S3_BUCKET=taven
TAVEN_S3_ACCESS_KEY_ID=taven
TAVEN_S3_SECRET_ACCESS_KEY=taven-local-only
TAVEN_S3_FORCE_PATH_STYLE=true
TAVEN_ORCA_EXECUTABLE=/opt/orca/AppRun
# Required private exchange used only by the Node worker and Orca sidecar.
TAVEN_ORCA_RUNNER_ROOT=/var/run/taven-orca
TAVEN_ORCA_VERSION=2.4.2
# Canonical native linux/amd64 digest from tools/slicing-fixtures/runtime.lock.json.
# Coolify must verify the deployed runner manifest before activation; if its
# digest differs, override this with that verified digest (without sha256:).
TAVEN_ORCA_IMAGE_SHA256=9b2d78073d052b6caa31303c21bf1da88201ec73ef0a523ded078c655c847953
TAVEN_ORCA_TIMEOUT_MILLISECONDS=900000
TAVEN_SLICER_MAX_SOURCE_BYTES=104857600
TAVEN_SLICER_MAX_ARTIFACT_BYTES=536870912
TAVEN_SLICER_MAX_DIAGNOSTIC_BYTES=1048576
