{
  "name": "@taven/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Taven internal administration application",
  "scripts": {
    "build": "vue-tsc -p tsconfig.json --noEmit && vite build",
    "dev": "vite",
    "lint": "eslint .",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@taven/openapi-client": "workspace:*",
    "@taven/ui-web": "workspace:*",
    "vue": "^3.5.0",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^26.1.0",
    "vite": "^8.1.0"
  }
}
