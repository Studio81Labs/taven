# Local development only. Production credentials belong in the deployment
# environment and must never be committed.
DATABASE_URL=postgresql://taven:taven@127.0.0.1:5435/taven
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Reserved for the infrastructure adapters that land with their product slice.
TAVEN_REDIS_URL=redis://localhost:6381
TAVEN_SLICING_DISPATCH_POLL_MILLISECONDS=1000
TAVEN_SLICING_DISPATCH_CLAIM_LIMIT=25
TAVEN_S3_ENDPOINT=http://localhost:9010
# Optional browser-reachable endpoint used only when signing upload/download
# URLs. It defaults to TAVEN_S3_ENDPOINT for host-process development.
TAVEN_S3_PUBLIC_ENDPOINT=http://localhost:9010
TAVEN_S3_REGION=us-east-1
TAVEN_S3_BUCKET=taven
TAVEN_S3_ACCESS_KEY_ID=taven
TAVEN_S3_SECRET_ACCESS_KEY=taven-local-only
TAVEN_S3_FORCE_PATH_STYLE=true
TAVEN_S3_SIGNED_URL_TTL_SECONDS=900
TAVEN_UPLOAD_CLIENT_HASH_KEY=replace-with-at-least-32-random-characters
TAVEN_TRUSTED_PROXY_CIDRS=

# Fail-closed launch gates. Keep false until the linked binding inputs and photo
# retention policy have been explicitly approved under issue #38.
TAVEN_BINDING_QUOTE_FLOWS_ENABLED=false
TAVEN_QUOTE_PHOTO_UPLOADS_ENABLED=false

# Separate deploy-time secrets for request/offer capabilities and the temporary
# v0 operator boundary. Issue #24 replaces the operator token with real roles.
TAVEN_QUOTE_CAPABILITY_KEY=replace-with-at-least-32-random-characters
# JSON array of retired keys retained until every capability, idempotency record,
# and outbox message issued with them has expired or been delivered.
TAVEN_QUOTE_CAPABILITY_PREVIOUS_KEYS=[]
TAVEN_OPERATOR_API_TOKEN=replace-with-at-least-32-random-characters
# Provider-neutral endpoint snapshots. A production carrier adapter can replace
# this configured adapter without changing the automatic quote lifecycle.
TAVEN_DELIVERY_ENDPOINTS_JSON=[{"providerEndpointId":"local-zbox","endpointType":"pickup_point","addressSnapshot":{"country":"CZ","city":"Praha","label":"Local development Z-BOX"},"supportedCategoryIds":["zbox"],"provider":"local-development"}]
