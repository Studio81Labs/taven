# Local development only. Production credentials belong in the deployment
# environment and must never be committed.
DATABASE_URL=postgresql://taven:taven@127.0.0.1:5435/taven
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Reserved for the infrastructure adapters that land with their product slice.
TAVEN_REDIS_URL=redis://localhost:6381
TAVEN_SLICING_DISPATCH_POLL_MILLISECONDS=1000
TAVEN_SLICING_DISPATCH_CLAIM_LIMIT=25
TAVEN_S3_ENDPOINT=http://localhost:9010
# Optional browser-reachable endpoint used only when signing upload/download
# URLs. It defaults to TAVEN_S3_ENDPOINT for host-process development.
TAVEN_S3_PUBLIC_ENDPOINT=http://localhost:9010
TAVEN_S3_REGION=us-east-1
TAVEN_S3_BUCKET=taven
TAVEN_S3_ACCESS_KEY_ID=taven
TAVEN_S3_SECRET_ACCESS_KEY=taven-local-only
TAVEN_S3_FORCE_PATH_STYLE=true
TAVEN_S3_SIGNED_URL_TTL_SECONDS=900
TAVEN_UPLOAD_CLIENT_HASH_KEY=replace-with-at-least-32-random-characters
TAVEN_TRUSTED_PROXY_CIDRS=

# Selects one immutable PriceList revision. Create and validate a new revision
# before switching this value; never mutate a revision already used by a quote.
TAVEN_AUTOMATIC_PRICE_LIST_REVISION=automatic-v0-czk

# Fail-closed launch gates. Keep false until the linked binding inputs and photo
# retention policy have been explicitly approved under issue #38.
TAVEN_BINDING_QUOTE_FLOWS_ENABLED=false
TAVEN_QUOTE_PHOTO_UPLOADS_ENABLED=false
TAVEN_CHECKOUT_PAYMENT_FLOWS_ENABLED=false

# Provider-neutral checkout selection. Sandbox is deterministic and intended
# only for local/e2e use. Production can select Comgate without changing domain
# or checkout code; future providers implement the same port.
TAVEN_PAYMENT_PROVIDER=sandbox
TAVEN_PAYMENT_SANDBOX_PUBLIC_URL=http://localhost:3001
TAVEN_PAYMENT_SANDBOX_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
TAVEN_PUBLIC_SITE_URL=http://localhost:3000
TAVEN_CLAIM_POLICY_REVISION=claim-policy-draft-v0
# Set only after the approved Claim policy fixes the self-service window.
# TAVEN_CLAIM_WINDOW_DAYS=
TAVEN_TERMS_REVISION=terms-pending
# Optional publication consent remains unavailable while this revision is a draft.
TAVEN_PHOTO_CONSENT_REVISION=photo-consent-pending
# Required only with TAVEN_PAYMENT_PROVIDER=comgate.
# TAVEN_COMGATE_MERCHANT_ID=
# TAVEN_COMGATE_SECRET=
# TAVEN_COMGATE_TEST_MODE=true
# TAVEN_COMGATE_API_BASE_URL=https://payments.comgate.cz/v2.0

# Separate deploy-time secrets for request/offer capabilities and named operator
# sessions. Admin login configuration is deliberately environment-specific.
TAVEN_QUOTE_CAPABILITY_KEY=replace-with-at-least-32-random-characters
# JSON array of retired keys retained until every capability, idempotency record,
# and outbox message issued with them has expired or been delivered.
TAVEN_QUOTE_CAPABILITY_PREVIOUS_KEYS=[]
TAVEN_ENVIRONMENT=development
TAVEN_ADMIN_ORIGINS=http://localhost:3002
# Base64url-encoded, distinct 32-byte random keys. Rotating the CSRF key
# intentionally invalidates existing operator sessions.
TAVEN_ADMIN_CSRF_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE
TAVEN_ADMIN_CLIENT_HASH_KEY=YWJjZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXpBQkNERUY
# Required only when TAVEN_ENVIRONMENT is staging or production.
# TAVEN_GITHUB_APP_CLIENT_ID=
# TAVEN_GITHUB_APP_CLIENT_SECRET=
# TAVEN_GITHUB_APP_CALLBACK_URL=https://api.example.test/admin/auth/github/callback
# TAVEN_ADMIN_COMPLETION_URL=https://admin.example.test/
# TAVEN_GITHUB_LOGIN_ATTEMPT_ENCRYPTION_KEY=replace-with-base64url-32-byte-key
# Provider-neutral endpoint snapshots. A production carrier adapter can replace
# this configured adapter without changing the automatic quote lifecycle.
TAVEN_DELIVERY_ENDPOINTS_JSON=[{"providerEndpointId":"local-zbox","endpointType":"pickup_point","addressSnapshot":{"country":"CZ","city":"Praha","label":"Local development Z-BOX"},"supportedCategoryIds":["zbox"],"provider":"local-development"}]
# Keep CONFIGURED for local development and until the matching web release is
# deployed. PACKETA uses the public widget account ID only; do not supply a
# Packeta service password to the browser or this selector.
TAVEN_DELIVERY_SELECTOR_MODE=CONFIGURED
# Required only with TAVEN_DELIVERY_SELECTOR_MODE=PACKETA.
# TAVEN_PACKETA_WIDGET_ACCOUNT_ID=
# Optional bounded widget options object. The backend always fixes CZ/internal
# Packeta, no COD, and staffed/Z-BOX vendor restrictions for validation.
# TAVEN_PACKETA_WIDGET_OPTIONS_JSON={}
