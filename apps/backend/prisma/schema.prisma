  @@map("replacement_request_status")
}

enum ClaimOrigin {
  SHIPMENT_INCIDENT
  POST_DELIVERY_QUALITY

  @@map("claim_origin")
}

enum ClaimStatus {
  OPEN
  ACTIVE
  WITHDRAWN
  RESOLVED_REPLACEMENT
  RESOLVED_RESHIP
  RESOLVED_REFUND
  RESOLVED_REJECTED

  @@map("claim_status")
}

enum ClaimSlotResolutionStatus {
  PENDING
  REPLACEMENT_PENDING
  RESHIP_PENDING
  REFUND_PENDING
  DELIVERED_REPLACEMENT
  DELIVERED_RESHIP
  REFUNDED
  REJECTED
  WITHDRAWN

  @@map("claim_slot_resolution_status")
}

enum PriceAdjustmentReason {
  EXPRESS_BREACH
  PRODUCTION_FAILURE
  SHIPMENT_INCIDENT
  POST_DELIVERY_ISSUE
  CUSTOMER_CANCELLATION

  @@map("price_adjustment_reason")
}

enum OrderSettlementKind {
  UNAUTHORIZED_HANDOFF
  BALANCE_SETTLEMENT

  @@map("order_settlement_kind")
}

enum HandoffReconciliationStatus {
