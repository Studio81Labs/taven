  acceptanceEvent    ShipmentProviderEvent @relation(fields: [acceptanceEventId, reshipmentShipmentId], references: [id, shipmentId], onDelete: Restrict, onUpdate: NoAction, map: "reshipment_authorizations_acceptance_event_scope_fkey")

  @@unique([originalShipmentId, shipmentPlanId, orderId, orderPhaseId, deliveryDestinationId], map: "reshipment_authorizations_original_shipment_scope_key")
  @@unique([reshipmentShipmentId, shipmentPlanId, orderId, orderPhaseId, deliveryDestinationId], map: "reshipment_authorizations_reshipment_shipment_scope_key")
  @@unique([acceptanceEventId, reshipmentShipmentId], map: "reshipment_authorizations_acceptance_event_scope_key")
  @@index([claimId, consumedAt])
  @@index([orderId, consumedAt])
  @@map("reshipment_authorizations")
}

model ClaimSlotResolution {
  id                    String                    @id @default(uuid()) @db.Uuid
  claimId               String                    @map("claim_id") @db.Uuid
  fulfilmentSlotId      String                    @map("fulfilment_slot_id") @db.Uuid
  replacementRequestId  String?                   @map("replacement_request_id") @db.Uuid
  replacementShipmentId String?                   @map("replacement_shipment_id") @db.Uuid
  status                ClaimSlotResolutionStatus @default(PENDING)
  resolvedAt            DateTime?                 @map("resolved_at") @db.Timestamptz(3)
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  claim               Claim               @relation(fields: [claimId], references: [id], onDelete: Restrict)
  fulfilmentSlot      FulfilmentSlot      @relation(fields: [fulfilmentSlotId], references: [id], onDelete: Restrict)
  replacementRequest  ReplacementRequest? @relation(fields: [replacementRequestId], references: [id], onDelete: Restrict)
  replacementShipment Shipment?           @relation("ClaimResolutionReplacementShipment", fields: [replacementShipmentId], references: [id], onDelete: Restrict)

  @@unique([claimId, fulfilmentSlotId])
  @@index([fulfilmentSlotId, status])
  @@map("claim_slot_resolutions")
}

model PriceAdjustment {
  id                    String                @id @default(uuid()) @db.Uuid
  orderId               String                @map("order_id") @db.Uuid
  paymentId             String?               @map("payment_id") @db.Uuid
  claimId               String?               @map("claim_id") @db.Uuid
  sourceContractPriceId String                @map("source_contract_price_id") @db.Uuid
  idempotencyKey        String                @unique @map("idempotency_key") @db.VarChar(255)
  reason                PriceAdjustmentReason
  amountMinor           BigInt                @map("amount_minor")
  refundRequiredMinor   BigInt                @map("refund_required_minor")
  currency              String                @db.Char(3)
  allocation            Json                  @db.JsonB
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  order               Order                       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment             Payment?                    @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  claim               Claim?                      @relation(fields: [claimId], references: [id], onDelete: Restrict)
  sourceContractPrice OrderContractPriceRevision  @relation("AdjustmentSourceContractPrice", fields: [sourceContractPriceId], references: [id], onDelete: Restrict)
  resultContractPrice OrderContractPriceRevision? @relation("AdjustmentResultContractPrice")
  refunds             RefundTransaction[]

  @@index([orderId, createdAt])
  @@index([claimId])
  @@map("price_adjustments")
}

model OrderContractPriceRevision {
  id                  String          @id @default(uuid()) @db.Uuid
  orderId             String          @map("order_id") @db.Uuid
  basePriceSnapshotId String          @map("base_price_snapshot_id") @db.Uuid
  predecessorId       String?         @unique @map("predecessor_id") @db.Uuid
  priceAdjustmentId   String?         @unique @map("price_adjustment_id") @db.Uuid
  contractTotalMinor  BigInt          @map("contract_total_minor")
  taxRegime           SellerTaxRegime @map("tax_regime")
  vatRateBasisPoints  Int             @map("vat_rate_basis_points")
  netAmountMinor      BigInt          @map("net_amount_minor")
  vatAmountMinor      BigInt          @map("vat_amount_minor")
  currency            String          @db.Char(3)
  createdAt           DateTime        @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)

  order             Order                       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  basePriceSnapshot PriceSnapshot               @relation(fields: [basePriceSnapshotId], references: [id], onDelete: Restrict)
  predecessor       OrderContractPriceRevision? @relation("ContractPriceLineage", fields: [predecessorId], references: [id], onDelete: Restrict)
  successor         OrderContractPriceRevision? @relation("ContractPriceLineage")
  priceAdjustment   PriceAdjustment?            @relation("AdjustmentResultContractPrice", fields: [priceAdjustmentId], references: [id], onDelete: Restrict)
  sourceAdjustments PriceAdjustment[]           @relation("AdjustmentSourceContractPrice")
  activeForOrder    OrderActiveContractPrice?

  @@unique([id, orderId], map: "order_contract_price_revisions_order_scope_key")
  @@index([orderId, createdAt], map: "order_contract_price_revisions_order_created_idx")
  @@map("order_contract_price_revisions")
}

model OrderActiveContractPrice {
  orderId                 String @id @map("order_id") @db.Uuid
  contractPriceRevisionId String @unique @map("contract_price_revision_id") @db.Uuid

  order                 Order                      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  contractPriceRevision OrderContractPriceRevision @relation(fields: [contractPriceRevisionId, orderId], references: [id, orderId], onDelete: Restrict, map: "order_active_contract_prices_revision_scope_fkey")

  @@unique([contractPriceRevisionId, orderId], map: "order_active_contract_prices_revision_scope_key")
  @@map("order_active_contract_prices")
}

model ClaimWindowMigrationApproval {
  orderId             String   @id @map("order_id") @db.Uuid
  claimPolicyRevision String   @map("claim_policy_revision") @db.VarChar(100)
  claimWindowDays     Int      @map("claim_window_days")
  approvalReference   String   @map("approval_reference") @db.VarChar(500)
  approvedAt          DateTime @default(dbgenerated("clock_timestamp()")) @map("approved_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@map("claim_window_migration_approvals")
}

model RefundTransaction {
  id                             String       @id @default(uuid()) @db.Uuid
  paymentId                      String       @map("payment_id") @db.Uuid
  claimId                        String?      @map("claim_id") @db.Uuid
  priceAdjustmentId              String?      @map("price_adjustment_id") @db.Uuid
  replacesRefundTransactionId    String?      @map("replaces_refund_transaction_id") @db.Uuid
  replacesFailureProviderEventId String?      @map("replaces_failure_provider_event_id") @db.Uuid
  idempotencyKey                 String       @map("idempotency_key") @db.VarChar(255)
  provider                       String       @map("provider") @db.VarChar(100)
  providerRefundId               String?      @map("provider_refund_id") @db.VarChar(255)
  providerResultEventId          String?      @map("provider_result_event_id") @db.Uuid
  dispatchClaimedAt              DateTime?    @map("dispatch_claimed_at") @db.Timestamptz(3)
  sourceSuccessProviderEventId   String?      @map("source_success_provider_event_id") @db.Uuid
  reconciliationStartedAt        DateTime?    @map("reconciliation_started_at") @db.Timestamptz(3)
  amountMinor                    BigInt       @map("amount_minor")
  reason                         RefundReason
  status                         RefundStatus @default(PENDING)
  requestedAt                    DateTime     @default(dbgenerated("clock_timestamp()")) @map("requested_at") @db.Timestamptz(3)
  completedAt                    DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdAt                      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment                       Payment                 @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  claim                         Claim?                  @relation(fields: [claimId], references: [id], onDelete: Restrict)
  priceAdjustment               PriceAdjustment?        @relation(fields: [priceAdjustmentId], references: [id], onDelete: Restrict)
  replacesRefundTransaction     RefundTransaction?      @relation("RefundRetryLineage", fields: [replacesRefundTransactionId, paymentId], references: [id, paymentId], onDelete: Restrict, map: "refund_transactions_replaces_scope_fkey")
  replacementRefundTransactions RefundTransaction[]     @relation("RefundRetryLineage")
  replacesFailureProviderEvent  PaymentProviderEvent?   @relation("RefundRetryFailureEvent", fields: [replacesFailureProviderEventId, replacesRefundTransactionId], references: [id, refundTransactionId], onDelete: Restrict, map: "refund_transactions_replaces_failure_event_scope_fkey")
  sourceSuccessProviderEvent    PaymentProviderEvent?   @relation("RefundRetrySourceSuccessEvent", fields: [sourceSuccessProviderEventId, replacesRefundTransactionId], references: [id, refundTransactionId], onDelete: Restrict, map: "refund_transactions_source_success_event_scope_fkey")
  providerEvents                PaymentProviderEvent[]  @relation("RefundProviderEvents")
  providerResultEvent           PaymentProviderEvent?   @relation("RefundSelectedResultEvent", fields: [providerResultEventId, id], references: [id, refundTransactionId], onDelete: Restrict, map: "refund_transactions_provider_result_event_scope_fkey")
  auditEvents                   AuditEvent[]
  handoffReconciliations        HandoffReconciliation[]
  orderSettlement               OrderSettlement?
  dispatchClaim                 RefundDispatchClaim?

  @@unique([id, paymentId])
  @@unique([replacesFailureProviderEventId, replacesRefundTransactionId], map: "refund_transactions_replaces_failure_event_key")
  @@unique([paymentId, idempotencyKey])
  @@unique([provider, providerRefundId], map: "refund_transactions_provider_provider_refund_id_key")
  @@unique([providerResultEventId, id], map: "refund_transactions_provider_result_event_scope_key")
  @@unique([sourceSuccessProviderEventId, replacesRefundTransactionId], map: "refund_transactions_source_success_event_scope_key")
  @@index([replacesRefundTransactionId, paymentId], map: "refund_transactions_replaces_payment_id_idx")
  @@index([paymentId, status])
  @@index([claimId, status])
  @@index([priceAdjustmentId])
  @@map("refund_transactions")
}

model RefundDispatchClaim {
  refundTransactionId String   @id @map("refund_transaction_id") @db.Uuid
  claimedAt           DateTime @default(dbgenerated("clock_timestamp()")) @map("claimed_at") @db.Timestamptz(3)
  createdAt           DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)

  refundTransaction RefundTransaction @relation(fields: [refundTransactionId], references: [id], onDelete: Restrict)

  @@map("refund_dispatch_claims")
}

model PaymentProviderEvent {
  id                    String                   @id @default(uuid()) @db.Uuid
  paymentId             String                   @map("payment_id") @db.Uuid
  refundTransactionId   String?                  @map("refund_transaction_id") @db.Uuid
  provider              String                   @db.VarChar(100)
  providerEventId       String                   @map("provider_event_id") @db.VarChar(255)
  providerTransactionId String                   @map("provider_transaction_id") @db.VarChar(255)
  kind                  PaymentProviderEventKind
  amountMinor           BigInt                   @map("amount_minor")
  currency              String                   @db.Char(3)
  payload               Json                     @db.JsonB
  payloadHash           String                   @map("payload_hash") @db.Char(64)
  occurredAt            DateTime                 @map("occurred_at") @db.Timestamptz(3)
  authenticatedAt       DateTime                 @map("authenticated_at") @db.Timestamptz(3)
  verifiedAt            DateTime                 @map("verified_at") @db.Timestamptz(3)
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  payment                      Payment                 @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  refundTransaction            RefundTransaction?      @relation("RefundProviderEvents", fields: [refundTransactionId], references: [id], onDelete: Restrict)
  selectedByRefundTransaction  RefundTransaction?      @relation("RefundSelectedResultEvent")
  retryingRefundTransaction    RefundTransaction?      @relation("RefundRetryFailureEvent")
  suspendingRefundTransaction  RefundTransaction?      @relation("RefundRetrySourceSuccessEvent")
  handoffRefundReconciliations HandoffReconciliation[] @relation("HandoffRefundProviderEvent")

  @@unique([id, refundTransactionId])
  @@unique([provider, providerEventId], map: "payment_provider_events_provider_provider_event_id_key")
  @@index([provider, providerTransactionId], map: "payment_provider_events_provider_provider_transaction_id_idx")
  @@index([paymentId, kind])
  @@index([refundTransactionId, kind])
  @@map("payment_provider_events")
}

model AuditEvent {
  id                  String         @id @default(uuid()) @db.Uuid
  quoteRequestId      String?        @map("quote_request_id") @db.Uuid
  quoteId             String?        @map("quote_id") @db.Uuid
  orderId             String?        @map("order_id") @db.Uuid
  paymentId           String?        @map("payment_id") @db.Uuid
  refundTransactionId String?        @map("refund_transaction_id") @db.Uuid
  eventType           String         @map("event_type") @db.VarChar(150)
  actorKind           AuditActorKind @default(SYSTEM) @map("actor_kind")
  actorId             String?        @map("actor_id") @db.Uuid
  correlationId       String?        @map("correlation_id") @db.Uuid
  idempotencyKey      String?        @map("idempotency_key") @db.VarChar(255)
  payload             Json           @db.JsonB
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  quoteRequest      QuoteRequest?      @relation(fields: [quoteRequestId], references: [id], onDelete: Restrict)
  quote             Quote?             @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  order             Order?             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment           Payment?           @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  refundTransaction RefundTransaction? @relation(fields: [refundTransactionId], references: [id], onDelete: Restrict)

  @@index([quoteRequestId, createdAt])
  @@index([quoteId, createdAt])
  @@index([orderId, createdAt])
  @@index([paymentId, createdAt])
  @@index([refundTransactionId, createdAt])
  @@map("audit_events")
}
