  PRINT_CONFIG
  REFERENCE_PROFILE
  MACHINE_PROFILE
  MACHINE_CALIBRATION

  @@map("revision_kind")
}

enum RevisionState {
  DRAFT
  ACTIVE
  RETIRED

  @@map("revision_state")
}

enum Material {
