enum AutomaticQuoteRiskDecision {
  ACKNOWLEDGED
  DECLINED

  @@map("automatic_quote_risk_decision")
}

model RevisionIdentity {
  id        String       @id @db.Uuid
  kind      RevisionKind
  digest    String       @unique @db.VarChar(64)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  printConfig        PrintConfigRevision?
  referenceProfile   ReferenceProfile?
  machineProfile     MachineProfile?
  machineCalibration MachineCalibration?

  @@map("revision_identities")
}

model ModelFile {
  id                     String          @id @default(uuid()) @db.Uuid
  format                 ModelFileFormat
  originalFilename       String          @map("original_filename") @db.VarChar(255)
  storageObjectKey       String          @unique @map("storage_object_key") @db.Text
  contentHash            String          @map("content_hash") @db.VarChar(64)
  sizeBytes              BigInt          @map("size_bytes")
  uploadedAt             DateTime        @map("uploaded_at") @db.Timestamptz(3)
  sourceDeleteAfter      DateTime        @map("source_delete_after") @db.Timestamptz(3)
  sourceRetentionDays    Int             @default(90) @map("source_retention_days")
  retentionHold          RetentionHold   @default(NONE) @map("retention_hold")
  deletedAt              DateTime?       @map("deleted_at") @db.Timestamptz(3)
  retentionDeletionJobId String?         @unique @map("retention_deletion_job_id") @db.Uuid
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  geometries             ModelGeometry[]
  preflightFindings      PreflightFinding[]
  quoteItems             QuoteItem[]               @relation("QuoteItemSourceModelFile")
  orderItems             OrderItem[]               @relation("OrderItemSourceModelFile")
  confirmedUploadIntents UploadIntent[]            @relation("UploadIntentModelFile")
  retentionDeletionJob   RetentionDeletionJob?     @relation("ModelFileRetentionDeletionJob", fields: [retentionDeletionJobId], references: [id], onDelete: Restrict)
  automaticQuoteFiles    AutomaticQuoteModelFile[]
  automaticQuoteItems    AutomaticQuoteItemDraft[]

  @@index([contentHash])
  @@index([sourceDeleteAfter, retentionHold, deletedAt])
  @@map("model_files")
}

model ModelGeometry {
  id                     String    @id @default(uuid()) @db.Uuid
  sourceModelFileId      String    @map("source_model_file_id") @db.Uuid
  sourceSelector         String?   @map("source_selector") @db.Text
  canonicalObjectKey     String    @unique @map("canonical_object_key") @db.Text
  geometryHash           String    @map("geometry_hash") @db.VarChar(64)
  canonicalizerRevision  String    @map("canonicalizer_revision") @db.VarChar(64)
  volumeCubicMicrometers BigInt    @map("volume_cubic_micrometers")
  boundsXMicrometers     BigInt    @map("bounds_x_micrometers")
  boundsYMicrometers     BigInt    @map("bounds_y_micrometers")
  boundsZMicrometers     BigInt    @map("bounds_z_micrometers")
  triangleCount          Int       @map("triangle_count")
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  sourceModelFile    ModelFile                   @relation(fields: [sourceModelFileId], references: [id], onDelete: Restrict)
  preflightFindings  PreflightFinding[]
  sliceResults       SliceResult[]
  candidateEstimates CandidateResourceEstimate[]
  quoteItems         QuoteItem[]
  orderItems         OrderItem[]

  @@unique([id, sourceModelFileId])
  @@index([sourceModelFileId])
  @@index([geometryHash])
  @@map("model_geometries")
}

model PreflightFinding {
  id                 String            @id @default(uuid()) @db.Uuid
  modelFileId        String            @map("model_file_id") @db.Uuid
  modelGeometryId    String?           @map("model_geometry_id") @db.Uuid
  inspectionRevision String            @map("inspection_revision") @db.VarChar(64)
  code               String            @db.VarChar(100)
  severity           PreflightSeverity
  message            String            @db.Text
  evidence           Json?             @db.JsonB
  acknowledgedAt     DateTime?         @map("acknowledged_at") @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  modelFile                   ModelFile                          @relation(fields: [modelFileId], references: [id], onDelete: Restrict)
  modelGeometry               ModelGeometry?                     @relation(fields: [modelGeometryId, modelFileId], references: [id, sourceModelFileId], onDelete: Restrict)
  automaticQuoteRiskDecisions AutomaticQuoteRiskDecisionRecord[]

  @@unique([modelGeometryId, inspectionRevision, code], map: "preflight_findings_geometry_scope_key")
  @@index([modelGeometryId])
  @@index([severity, acknowledgedAt])
  @@map("preflight_findings")
}

model PhotoAsset {
  id                     String         @id @default(uuid()) @db.Uuid
  kind                   PhotoAssetKind
  scopeKind              PhotoScopeKind @map("scope_kind")
  scopeId                String         @map("scope_id") @db.Uuid
  storageObjectKey       String         @unique @map("storage_object_key") @db.Text
  contentHash            String         @map("content_hash") @db.VarChar(64)
  mediaType              String         @map("media_type") @db.VarChar(100)
  sizeBytes              BigInt         @map("size_bytes")
  uploadedAt             DateTime       @map("uploaded_at") @db.Timestamptz(3)
  retentionDays          Int            @default(90) @map("retention_days")
  photoDeleteAfter       DateTime       @map("photo_delete_after") @db.Timestamptz(3)
  retentionHold          RetentionHold  @default(NONE) @map("retention_hold")
  deletedAt              DateTime?      @map("deleted_at") @db.Timestamptz(3)
  retentionDeletionJobId String?        @unique @map("retention_deletion_job_id") @db.Uuid
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  qcJobs                 Job[]                 @relation("JobQcPhotoAsset")
  confirmedUploadIntents UploadIntent[]        @relation("UploadIntentPhotoAsset")
  retentionDeletionJob   RetentionDeletionJob? @relation("PhotoAssetRetentionDeletionJob", fields: [retentionDeletionJobId], references: [id], onDelete: Restrict)

  @@index([contentHash])
  @@index([scopeKind, scopeId])
  @@index([photoDeleteAfter, retentionHold, deletedAt])
  @@map("photo_assets")
}

model UploadIntent {
  id                    String             @id @default(uuid()) @db.Uuid
  customerId            String?            @map("customer_id") @db.Uuid
  assetKind             UploadAssetKind    @map("asset_kind")
  capabilityTokenHash   String             @unique @map("capability_token_hash") @db.VarChar(64)
  originalFilename      String?            @map("original_filename") @db.VarChar(255)
  modelFormat           ModelFileFormat?   @map("model_format")
  photoKind             PhotoAssetKind?    @map("photo_kind")
  photoScopeKind        PhotoScopeKind?    @map("photo_scope_kind")
  photoScopeId          String?            @map("photo_scope_id") @db.Uuid
  intendedAssetId       String             @map("intended_asset_id") @db.Uuid
  expectedContentType   String             @map("expected_content_type") @db.VarChar(100)
  expectedSizeBytes     BigInt             @map("expected_size_bytes")
  expectedContentHash   String             @map("expected_content_hash") @db.VarChar(64)
  quarantineObjectKey   String             @unique @map("quarantine_object_key") @db.Text
  finalObjectKey        String             @unique @map("final_object_key") @db.Text
  expiresAt             DateTime           @map("expires_at") @db.Timestamptz(3)
  status                UploadIntentStatus @default(PENDING)
  confirmedModelFileId  String?            @unique @map("confirmed_model_file_id") @db.Uuid
  confirmedPhotoAssetId String?            @unique @map("confirmed_photo_asset_id") @db.Uuid
  confirmedAt           DateTime?          @map("confirmed_at") @db.Timestamptz(3)
  failureReason         String?            @map("failure_reason") @db.Text
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer            Customer?   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  confirmedModelFile  ModelFile?  @relation("UploadIntentModelFile", fields: [confirmedModelFileId], references: [id], onDelete: Restrict)
  confirmedPhotoAsset PhotoAsset? @relation("UploadIntentPhotoAsset", fields: [confirmedPhotoAssetId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@index([status, expiresAt])
  @@map("upload_intents")
}

model AnonymousUploadLimit {
  subjectHash     String   @id @map("subject_hash") @db.VarChar(64)
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(3)
  windowExpiresAt DateTime @map("window_expires_at") @db.Timestamptz(3)
  issuedCount     Int      @default(0) @map("issued_count")
  reservedBytes   BigInt   @default(0) @map("reserved_bytes")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([windowExpiresAt])
  @@map("anonymous_upload_limits")
}

model AnonymousQuoteLimit {
  subjectHash     String   @id @map("subject_hash") @db.VarChar(64)
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(3)
  windowExpiresAt DateTime @map("window_expires_at") @db.Timestamptz(3)
  issuedCount     Int      @default(0) @map("issued_count")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([windowExpiresAt])
  @@map("anonymous_quote_limits")
}

model PaymentWebhookLimit {
  subjectHash     String   @id @map("subject_hash") @db.VarChar(64)
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(3)
  windowExpiresAt DateTime @map("window_expires_at") @db.Timestamptz(3)
  issuedCount     Int      @default(0) @map("issued_count")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([windowExpiresAt])
  @@map("payment_webhook_limits")
}

model ObjectStorageSweepCursor {
  sweepName       String   @id @map("sweep_name") @db.VarChar(64)
  cursorObjectKey String?  @map("cursor_object_key") @db.Text
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("object_storage_sweep_cursors")
}

model RetentionDeletionJob {
  id                         String                     @id @default(uuid()) @db.Uuid
  assetKind                  RetentionAssetKind         @map("asset_kind")
  assetId                    String                     @map("asset_id") @db.Uuid
  expectedDeleteAfter        DateTime                   @map("expected_delete_after") @db.Timestamptz(3)
  status                     RetentionDeletionJobStatus @default(PENDING)
  attempts                   Int                        @default(0)
  availableAt                DateTime                   @default(now()) @map("available_at") @db.Timestamptz(3)
  leaseUntil                 DateTime?                  @map("lease_until") @db.Timestamptz(3)
  leaseToken                 String?                    @map("lease_token") @db.VarChar(64)
  uploadSettlementVerifiedAt DateTime?                  @map("upload_settlement_verified_at") @db.Timestamptz(3)
  lastError                  String?                    @map("last_error") @db.Text
  completedAt                DateTime?                  @map("completed_at") @db.Timestamptz(3)
  createdAt                  DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  modelFile  ModelFile?  @relation("ModelFileRetentionDeletionJob")
  photoAsset PhotoAsset? @relation("PhotoAssetRetentionDeletionJob")

  @@unique([assetKind, assetId, expectedDeleteAfter], map: "retention_deletion_jobs_asset_deadline_key")
  @@index([status, availableAt])
  @@index([assetKind, assetId, status])
  @@map("retention_deletion_jobs")
}

model PrintConfigRevision {
  id                     String       @id @db.Uuid
  quality                PrintQuality
  infillPercent          Int          @map("infill_percent")
  layerHeightMicrometers Int          @map("layer_height_micrometers")
  supportsEnabled        Boolean      @default(false) @map("supports_enabled")
  brimEnabled            Boolean      @default(false) @map("brim_enabled")
  settings               Json         @db.JsonB
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  revision               RevisionIdentity            @relation(fields: [id], references: [id], onDelete: Restrict)
  sliceResults           SliceResult[]
  candidateEstimates     CandidateResourceEstimate[]
  productionReservations ProductionReservation[]
  orderItems             OrderItem[]
  quoteItems             QuoteItem[]
  automaticQuoteItems    AutomaticQuoteItemDraft[]

  @@index([quality, infillPercent])
  @@map("print_config_revisions")
}

model ReferenceProfile {
  id            String        @id @db.Uuid
  material      Material
  quality       PrintQuality
  slicerEngine  String        @map("slicer_engine") @db.VarChar(100)
  slicerVersion String        @map("slicer_version") @db.VarChar(100)
  settings      Json          @db.JsonB
  state         RevisionState @default(DRAFT)
  activatedAt   DateTime?     @map("activated_at") @db.Timestamptz(3)
  retiredAt     DateTime?     @map("retired_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  revision            RevisionIdentity          @relation(fields: [id], references: [id], onDelete: Restrict)
  sliceResults        SliceResult[]
  machineProfiles     MachineProfile[]
  automaticQuoteItems AutomaticQuoteItemDraft[]

  @@index([material, quality, state])
  @@map("reference_profiles")
}

model MachineCapability {
  id                         String     @id @default(uuid()) @db.Uuid
  capabilityKey              String     @unique @map("capability_key") @db.VarChar(100)
  manufacturer               String     @db.VarChar(100)
  model                      String     @db.VarChar(100)
  buildVolumeXMicrometers    BigInt     @map("build_volume_x_micrometers")
  buildVolumeYMicrometers    BigInt     @map("build_volume_y_micrometers")
  buildVolumeZMicrometers    BigInt     @map("build_volume_z_micrometers")
  supportedNozzleMicrometers Int[]      @map("supported_nozzle_micrometers")
  supportedMaterials         Material[] @map("supported_materials")
  createdAt                  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  machines        Machine[]
  machineProfiles MachineProfile[]

  @@map("machine_capabilities")
}

model MachineProfile {
  id                        String                   @id @db.Uuid
  machineCapabilityId       String                   @map("machine_capability_id") @db.Uuid
  referenceProfileId        String                   @map("reference_profile_id") @db.Uuid
  material                  Material
  quality                   PrintQuality
  nozzleDiameterMicrometers Int                      @map("nozzle_diameter_micrometers")
  slicerEngine              String                   @map("slicer_engine") @db.VarChar(100)
  slicerVersion             String                   @map("slicer_version") @db.VarChar(100)
  productionArtifactFormat  ProductionArtifactFormat @map("production_artifact_format")
  settings                  Json                     @db.JsonB
  state                     RevisionState            @default(DRAFT)
  activatedAt               DateTime?                @map("activated_at") @db.Timestamptz(3)
