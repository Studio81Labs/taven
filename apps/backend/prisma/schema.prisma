  order                     Order                        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  priceSnapshot             PriceSnapshot                @relation(fields: [priceSnapshotId], references: [id], onDelete: Restrict)
  deliveryDestination       DeliveryDestination          @relation(fields: [deliveryDestinationId, orderId], references: [id, orderId], onDelete: Restrict)
  activeForOrder            OrderActivePriceBinding?
  shipmentPlans             ShipmentPlan[]
  fulfilmentSlotAllocations ShipmentPlanFulfilmentSlot[]
  payments                  Payment[]

  @@unique([orderId, priceSnapshotId], map: "order_price_bindings_order_snapshot_key")
  @@unique([id, orderId, priceSnapshotId], map: "order_price_bindings_payment_contract_key")
  @@unique([id, orderId, priceSnapshotId, deliveryDestinationId], map: "order_price_bindings_contract_destination_key")
  @@map("order_price_bindings")
}

model DeliveryDestination {
  id                 String   @id @default(uuid()) @db.Uuid
  orderId            String   @map("order_id") @db.Uuid
  providerEndpointId String   @map("provider_endpoint_id") @db.VarChar(255)
  endpointType       String   @map("endpoint_type") @db.VarChar(100)
  addressSnapshot    Json     @map("address_snapshot") @db.JsonB
  capabilitySnapshot Json     @map("capability_snapshot") @db.JsonB
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order         Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  priceBindings OrderPriceBinding[]
  shipmentPlans ShipmentPlan[]
  shipments     Shipment[]

  @@unique([id, orderId])
  @@index([orderId, createdAt])
  @@map("delivery_destinations")
}

model OrderActivePriceBinding {
  orderId             String @id @map("order_id") @db.Uuid
  orderPriceBindingId String @unique @map("order_price_binding_id") @db.Uuid

  order             Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderPriceBinding OrderPriceBinding @relation(fields: [orderPriceBindingId], references: [id], onDelete: Restrict)

  @@map("order_active_price_bindings")
}

model OrderItem {
  id                     String   @id @default(uuid()) @db.Uuid
  orderId                String   @map("order_id") @db.Uuid
  ordinal                Int
  sourceModelFileId      String   @map("source_model_file_id") @db.Uuid
  modelGeometryId        String   @map("model_geometry_id") @db.Uuid
  printConfigRevisionId  String   @map("print_config_revision_id") @db.Uuid
  referenceSliceResultId String?  @map("reference_slice_result_id") @db.Uuid
  material               Material
  color                  String?  @db.VarChar(100)
  quantity               Int
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order                Order                      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sourceModelFile      ModelFile                  @relation("OrderItemSourceModelFile", fields: [sourceModelFileId], references: [id], onDelete: Restrict)
  modelGeometry        ModelGeometry              @relation(fields: [modelGeometryId, sourceModelFileId], references: [id, sourceModelFileId], onDelete: Restrict)
  printConfigRevision  PrintConfigRevision        @relation(fields: [printConfigRevisionId], references: [id], onDelete: Restrict)
  referenceSliceResult SliceResult?               @relation(fields: [referenceSliceResultId], references: [id], onDelete: Restrict)
  individualSource     IndividualOrderItemSource?
  priceComponents      PriceSnapshotComponent[]
  fulfilmentSlots      FulfilmentSlot[]

  @@unique([orderId, ordinal])
  @@unique([id, orderId])
  @@index([modelGeometryId])
  @@map("order_items")
}

model IndividualOrderItemSource {
  orderItemId String @id @map("order_item_id") @db.Uuid
  quoteItemId String @unique @map("quote_item_id") @db.Uuid

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quoteItem QuoteItem @relation(fields: [quoteItemId], references: [id], onDelete: Restrict)

  @@map("individual_order_item_sources")
}

model OrderPhase {
  id          String           @id @default(uuid()) @db.Uuid
  orderId     String           @unique @map("order_id") @db.Uuid
  kind        OrderPhaseKind   @default(SINGLE)
  status      OrderPhaseStatus @default(QUOTED)
  activatedAt DateTime?        @map("activated_at") @db.Timestamptz(3)
  qcPassedAt  DateTime?        @map("qc_passed_at") @db.Timestamptz(3)
  shippedAt   DateTime?        @map("shipped_at") @db.Timestamptz(3)
  deliveredAt DateTime?        @map("delivered_at") @db.Timestamptz(3)
  completedAt DateTime?        @map("completed_at") @db.Timestamptz(3)
  cancelledAt DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  order                Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  eligibilitySnapshots EligibilitySnapshot[]
  fulfilmentSlots      FulfilmentSlot[]
  shipmentPlans        ShipmentPlan[]
  shipments            Shipment[]
  jobs                 Job[]

  @@unique([id, orderId])
  @@map("order_phases")
}

model ShipmentPlan {
  id                      String   @id @default(uuid()) @db.Uuid
  orderId                 String   @map("order_id") @db.Uuid
  orderPhaseId            String   @map("order_phase_id") @db.Uuid
  priceSnapshotId         String   @map("price_snapshot_id") @db.Uuid
  orderPriceBindingId     String   @map("order_price_binding_id") @db.Uuid
  deliveryDestinationId   String   @map("delivery_destination_id") @db.Uuid
  ordinal                 Int
  category                String   @db.VarChar(100)
  plannedVolumeCubicMm    BigInt   @map("planned_volume_cubic_mm")
  plannedWeightMilligrams BigInt   @map("planned_weight_milligrams")
  shippingAmountMinor     BigInt   @map("shipping_amount_minor")
  packagingAmountMinor    BigInt   @map("packaging_amount_minor")
  handlingAmountMinor     BigInt   @map("handling_amount_minor")
  allocationSnapshot      Json     @map("allocation_snapshot") @db.JsonB
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order                     Order                        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderPriceBinding         OrderPriceBinding            @relation(fields: [orderPriceBindingId, orderId, priceSnapshotId, deliveryDestinationId], references: [id, orderId, priceSnapshotId, deliveryDestinationId], onDelete: Restrict, map: "shipment_plans_order_snapshot_fkey")
  orderPhase                OrderPhase                   @relation(fields: [orderPhaseId, orderId], references: [id, orderId], onDelete: Restrict)
  priceSnapshot             PriceSnapshot                @relation(fields: [priceSnapshotId], references: [id], onDelete: Restrict)
  deliveryDestination       DeliveryDestination          @relation(fields: [deliveryDestinationId, orderId], references: [id, orderId], onDelete: Restrict)
  priceComponents           PriceSnapshotComponent[]
  fulfilmentSlotAllocations ShipmentPlanFulfilmentSlot[]
  shipments                 Shipment[]
  candidateEstimates        CandidateResourceEstimate[]
  jobs                      Job[]

  @@unique([orderPhaseId, orderPriceBindingId, ordinal])
  @@unique([id, orderPriceBindingId])
  @@unique([id, orderId, orderPhaseId])
  @@unique([id, orderId, orderPhaseId, deliveryDestinationId])
  @@unique([id, priceSnapshotId])
  @@index([orderId])
  @@map("shipment_plans")
}

model FulfilmentSlot {
  id                    String                @id @default(uuid()) @db.Uuid
  orderId               String                @map("order_id") @db.Uuid
  orderPhaseId          String                @map("order_phase_id") @db.Uuid
  orderItemId           String                @map("order_item_id") @db.Uuid
  quantityOrdinal       Int                   @map("quantity_ordinal")
  settlementAmountMinor BigInt                @map("settlement_amount_minor")
  outcome               FulfilmentSlotOutcome @default(PENDING)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  order                     Order                                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderPhase                OrderPhase                           @relation(fields: [orderPhaseId, orderId], references: [id, orderId], onDelete: Restrict)
  orderItem                 OrderItem                            @relation(fields: [orderItemId, orderId], references: [id, orderId], onDelete: Restrict)
  planSlots                 PhaseResourcePlanSlot[]
  shipmentPlanAllocations   ShipmentPlanFulfilmentSlot[]
  priceComponentAllocations PriceComponentFulfilmentAllocation[]

  @@unique([orderItemId, orderPhaseId, quantityOrdinal])
  @@index([orderPhaseId])
  @@map("fulfilment_slots")
}

model ShipmentPlanFulfilmentSlot {
  shipmentPlanId      String @map("shipment_plan_id") @db.Uuid
  orderPriceBindingId String @map("order_price_binding_id") @db.Uuid
  fulfilmentSlotId    String @map("fulfilment_slot_id") @db.Uuid

  shipmentPlan      ShipmentPlan      @relation(fields: [shipmentPlanId, orderPriceBindingId], references: [id, orderPriceBindingId], onDelete: Restrict)
  orderPriceBinding OrderPriceBinding @relation(fields: [orderPriceBindingId], references: [id], onDelete: Restrict)
  fulfilmentSlot    FulfilmentSlot    @relation(fields: [fulfilmentSlotId], references: [id], onDelete: Restrict)

  @@id([shipmentPlanId, fulfilmentSlotId])
  @@unique([orderPriceBindingId, fulfilmentSlotId])
  @@index([fulfilmentSlotId])
  @@map("shipment_plan_fulfilment_slots")
}

model Shipment {
  id                    String         @id @default(uuid()) @db.Uuid
  orderId               String         @map("order_id") @db.Uuid
  orderPhaseId          String         @map("order_phase_id") @db.Uuid
  shipmentPlanId        String         @map("shipment_plan_id") @db.Uuid
  deliveryDestinationId String         @map("delivery_destination_id") @db.Uuid
  replacesShipmentId    String?        @map("replaces_shipment_id") @db.Uuid
  status                ShipmentStatus @default(PLANNED)
  carrier               String?        @db.VarChar(100)
  providerShipmentId    String?        @unique @map("provider_shipment_id") @db.VarChar(255)
  trackingCode          String?        @map("tracking_code") @db.VarChar(255)
  labelCreatedAt        DateTime?      @map("label_created_at") @db.Timestamptz(3)
  handedOverAt          DateTime?      @map("handed_over_at") @db.Timestamptz(3)
  deliveredAt           DateTime?      @map("delivered_at") @db.Timestamptz(3)
  cancelledAt           DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  order               Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderPhase          OrderPhase          @relation(fields: [orderPhaseId, orderId], references: [id, orderId], onDelete: Restrict)
  shipmentPlan        ShipmentPlan        @relation(fields: [shipmentPlanId, orderId, orderPhaseId, deliveryDestinationId], references: [id, orderId, orderPhaseId, deliveryDestinationId], onDelete: Restrict)
  deliveryDestination DeliveryDestination @relation(fields: [deliveryDestinationId, orderId], references: [id, orderId], onDelete: Restrict)
  replacesShipment    Shipment?           @relation("ShipmentReplacementLineage", fields: [replacesShipmentId, shipmentPlanId, orderId, orderPhaseId, deliveryDestinationId], references: [id, shipmentPlanId, orderId, orderPhaseId, deliveryDestinationId], onDelete: Restrict, map: "shipments_replacement_scope_fkey")
  replacementShipment Shipment?           @relation("ShipmentReplacementLineage")

  @@unique([id, shipmentPlanId, orderId, orderPhaseId, deliveryDestinationId], map: "shipments_lineage_scope_key")
  @@unique([replacesShipmentId, shipmentPlanId, orderId, orderPhaseId, deliveryDestinationId], map: "shipments_replaces_shipment_id_key")
  @@index([orderId, status])
  @@index([shipmentPlanId, status])
  @@map("shipments")
}

model Job {
  id                      String                 @id @default(uuid()) @db.Uuid
  nodeId                  String                 @map("node_id") @db.Uuid
  orderId                 String                 @map("order_id") @db.Uuid
  orderPhaseId            String                 @map("order_phase_id") @db.Uuid
  shipmentPlanId          String                 @map("shipment_plan_id") @db.Uuid
  phaseResourcePlanJobId  String                 @map("phase_resource_plan_job_id") @db.Uuid
  status                  JobStatus              @default(CREATED)
  acceptedAt              DateTime?              @map("accepted_at") @db.Timestamptz(3)
  gcodeReadyAt            DateTime?              @map("gcode_ready_at") @db.Timestamptz(3)
  productionSliceResultId String?                @map("production_slice_result_id") @db.Uuid
  productionArtifactHash  String?                @map("production_artifact_hash") @db.VarChar(64)
  printingAt              DateTime?              @map("printing_at") @db.Timestamptz(3)
  printedAt               DateTime?              @map("printed_at") @db.Timestamptz(3)
  photoSubmittedAt        DateTime?              @map("photo_submitted_at") @db.Timestamptz(3)
  qcPhotoAssetId          String?                @unique @map("qc_photo_asset_id") @db.Uuid
  qcApprovedAt            DateTime?              @map("qc_approved_at") @db.Timestamptz(3)
  qcRejectedAt            DateTime?              @map("qc_rejected_at") @db.Timestamptz(3)
  packedAt                DateTime?              @map("packed_at") @db.Timestamptz(3)
  handedOverAt            DateTime?              @map("handed_over_at") @db.Timestamptz(3)
  settledAt               DateTime?              @map("settled_at") @db.Timestamptz(3)
  failedAt                DateTime?              @map("failed_at") @db.Timestamptz(3)
  failureStage            JobFailureStage?       @map("failure_stage")
  failureReason           String?                @map("failure_reason") @db.Text
  cancelledAt             DateTime?              @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason      JobCancellationReason? @map("cancellation_reason")
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  node                   Node                    @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  order                  Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderPhase             OrderPhase              @relation(fields: [orderPhaseId, orderId], references: [id, orderId], onDelete: Restrict)
  shipmentPlan           ShipmentPlan            @relation(fields: [shipmentPlanId, orderId, orderPhaseId], references: [id, orderId, orderPhaseId], onDelete: Restrict)
  phaseResourcePlanJob   PhaseResourcePlanJob    @relation(fields: [phaseResourcePlanJobId, nodeId], references: [id, nodeId], onDelete: Restrict)
  productionSliceResult  SliceResult?            @relation("JobProductionSliceResult", fields: [productionSliceResultId], references: [id], onDelete: Restrict)
  qcPhotoAsset           PhotoAsset?             @relation("JobQcPhotoAsset", fields: [qcPhotoAssetId], references: [id], onDelete: Restrict)
  productionReservations ProductionReservation[] @relation("ProductionReservationJob")

  @@unique([id, nodeId, phaseResourcePlanJobId])
  @@unique([phaseResourcePlanJobId])
  @@index([shipmentPlanId, status])
  @@index([nodeId, status])
  @@index([productionSliceResultId])
  @@map("jobs")
}

model Payment {
  id                       String        @id @default(uuid()) @db.Uuid
  orderId                  String        @map("order_id") @db.Uuid
  priceSnapshotId          String        @map("price_snapshot_id") @db.Uuid
  orderPriceBindingId      String        @map("order_price_binding_id") @db.Uuid
  paymentScheduleId        String        @map("payment_schedule_id") @db.Uuid
  role                     PaymentRole
  provider                 String        @db.VarChar(100)
  providerIntentId         String?       @unique @map("provider_intent_id") @db.VarChar(255)
  providerCaptureId        String?       @unique @map("provider_capture_id") @db.VarChar(255)
  requestedAmountMinor     BigInt        @map("requested_amount_minor")
  capturedAmountMinor      BigInt?       @map("captured_amount_minor")
  currency                 String        @db.Char(3)
  status                   PaymentStatus @default(CREATED)
  captureAuthorized        Boolean       @default(true) @map("capture_authorized")
  captureCutoffAt          DateTime?     @map("capture_cutoff_at") @db.Timestamptz(3)
  checkoutCaptureExpiresAt DateTime?     @map("checkout_capture_expires_at") @db.Timestamptz(3)
  capturedAt               DateTime?     @map("captured_at") @db.Timestamptz(3)
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  orderPriceBinding OrderPriceBinding   @relation(fields: [orderPriceBindingId, orderId, priceSnapshotId], references: [id, orderId, priceSnapshotId], onDelete: Restrict, map: "payments_order_snapshot_fkey")
  priceSnapshot     PriceSnapshot       @relation(fields: [priceSnapshotId, currency], references: [id, currency], onDelete: Restrict, map: "payments_snapshot_currency_fkey")
  paymentSchedule   PaymentSchedule     @relation(fields: [paymentScheduleId, priceSnapshotId, role, requestedAmountMinor], references: [id, priceSnapshotId, role, grossAmountMinor], onDelete: Restrict, map: "payments_schedule_contract_fkey")
  refunds           RefundTransaction[]
  auditEvents       AuditEvent[]

  @@index([orderId, status])
  @@index([captureCutoffAt, status])
  @@index([checkoutCaptureExpiresAt, status])
  @@map("payments")
}

model RefundTransaction {
  id               String       @id @default(uuid()) @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  idempotencyKey   String       @map("idempotency_key") @db.VarChar(255)
  providerRefundId String?      @unique @map("provider_refund_id") @db.VarChar(255)
  amountMinor      BigInt       @map("amount_minor")
  reason           RefundReason
  status           RefundStatus @default(PENDING)
  requestedAt      DateTime     @default(now()) @map("requested_at") @db.Timestamptz(3)
  completedAt      DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment     Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  auditEvents AuditEvent[]

  @@unique([paymentId, idempotencyKey])
  @@index([paymentId, status])
  @@map("refund_transactions")
}

model AuditEvent {
  id                  String         @id @default(uuid()) @db.Uuid
  quoteId             String?        @map("quote_id") @db.Uuid
  orderId             String?        @map("order_id") @db.Uuid
  paymentId           String?        @map("payment_id") @db.Uuid
  refundTransactionId String?        @map("refund_transaction_id") @db.Uuid
  eventType           String         @map("event_type") @db.VarChar(150)
  actorKind           AuditActorKind @default(SYSTEM) @map("actor_kind")
  actorId             String?        @map("actor_id") @db.Uuid
  correlationId       String?        @map("correlation_id") @db.Uuid
  idempotencyKey      String?        @map("idempotency_key") @db.VarChar(255)
  payload             Json           @db.JsonB
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  quote             Quote?             @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  order             Order?             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment           Payment?           @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  refundTransaction RefundTransaction? @relation(fields: [refundTransactionId], references: [id], onDelete: Restrict)

  @@index([quoteId, createdAt])
  @@index([orderId, createdAt])
  @@index([paymentId, createdAt])
  @@index([refundTransactionId, createdAt])
  @@map("audit_events")
}
