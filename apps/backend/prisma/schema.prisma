  @@map("handoff_reconciliation_status")
}

enum AuditActorKind {
  SYSTEM
  CUSTOMER
  OPERATOR

  @@map("audit_actor_kind")
}

enum OperatorRole {
  ADMIN
  OPERATOR
  VIEWER

  @@map("operator_role")
}

enum OperatorAuthenticationMethod {
  DEVELOPMENT_PASSWORD
  GITHUB

  @@map("operator_authentication_method")
}

enum OperatorLoginAttemptStatus {
  PENDING
  EXCHANGING
  COMPLETED
  FAILED

  @@map("operator_login_attempt_status")
