{
  "name": "taven",
  "version": "0.0.0",
  "private": true,
  "description": "Taven — local 3D-printing services with deterministic quoting and production",
  "author": {
    "name": "Studio81 Labs s.r.o.",
    "email": "dev@studio81.cz",
    "url": "https://www.studio81.cz"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "prepare": "husky",
    "dev": "concurrently --names backend,web,admin --prefix-colors blue,magenta,green \"pnpm backend:dev\" \"pnpm web:dev\" \"pnpm admin:dev\"",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint && pnpm boundaries:check",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "boundaries:check": "node scripts/ci/check-boundaries.mjs",
    "generated:check": "bash scripts/ci/check-generated.sh",
    "ci:config:check": "node scripts/ci/check-workflow-coverage.mjs",
    "overrides:check": "python3 scripts/ci/check-pnpm-overrides.py",
    "baseline:check": "node scripts/ci/check-nexcue-baseline.mjs",
    "sibling:check": "bash scripts/ci/check-all-siblings.sh",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d --wait && docker compose -f infra/docker/docker-compose.yml run --rm minio-init",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "db:up": "pnpm infra:up",
    "db:down": "pnpm infra:down",
    "backend:dev": "pnpm -C apps/backend dev",
    "backend:build": "pnpm -C apps/backend build",
    "backend:lint": "pnpm -C apps/backend lint",
    "backend:typecheck": "pnpm -C apps/backend typecheck",
    "backend:test": "pnpm -C apps/backend test",
    "backend:test:e2e": "pnpm -C apps/backend test:e2e",
    "web:dev": "pnpm -C apps/web dev",
    "web:build": "pnpm -C apps/web build",
    "web:lint": "pnpm -C apps/web lint",
    "web:typecheck": "pnpm -C apps/web typecheck",
    "web:test": "pnpm -C apps/web test",
    "admin:dev": "pnpm -C apps/admin dev",
    "admin:build": "pnpm -C apps/admin build",
    "admin:lint": "pnpm -C apps/admin lint",
    "admin:typecheck": "pnpm -C apps/admin typecheck",
    "admin:test": "pnpm -C apps/admin test",
    "slicer-worker:dev": "pnpm -C apps/slicer-worker dev",
    "slicer-worker:build": "pnpm -C apps/slicer-worker build",
    "slicer-worker:lint": "pnpm -C apps/slicer-worker lint",
    "slicer-worker:typecheck": "pnpm -C apps/slicer-worker typecheck",
    "slicer-worker:test": "pnpm -C apps/slicer-worker test",
    "openapi:generate": "pnpm -C apps/backend db:generate && pnpm -C apps/backend openapi:export && pnpm -C packages/openapi generate",
    "db:migrate": "pnpm -C apps/backend db:migrate",
    "db:migrate:deploy": "pnpm -C apps/backend db:migrate:deploy",
    "db:studio": "pnpm -C apps/backend db:studio"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-vue": "^10.7.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "tsx": "^4.21.0",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,vue,json,md,yml,yaml,css}": "prettier --write --ignore-unknown"
  }
}
