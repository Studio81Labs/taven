{
  "name": "@taven/openapi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Emitted Taven OpenAPI contract and generation tooling",
  "scripts": {
    "build": "pnpm generate",
    "generate": "openapi-typescript openapi.json -o ../openapi-client/generated/schema.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
